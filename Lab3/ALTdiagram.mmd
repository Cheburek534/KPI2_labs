sequenceDiagram
    autonumber
    actor Client as Клієнт
    participant Site as Сайт
    participant Booking as Сервіс бронювання
    participant DB as База даних

    %% Базовий потік до розгалуження
    Client->>Site: Натискає на обране місце
    activate Site
    
    Site->>Booking: selectSeat(seatID, sessionID)
    activate Booking
    
    Booking->>DB: checkStatusOfSeat(seatID)
    activate DB
    DB-->>Booking: seatStatus
    deactivate DB

    %% Локальний умовний блок: обробка результату
    alt seatStatus == AVAILABLE
        Booking->>DB: lockSeat(seatID, 15min)
        activate DB
        DB-->>Booking: lockSuccess
        deactivate DB
        
        Booking-->>Site: status: success
        Site-->>Client: Зміна кольору місця, старт таймера 15 хв
    else seatStatus == LOCKED
        Booking-->>Site: status: error (seatTaken)
        Site-->>Client: Повідомлення "Місце зайнято", оновлення карти
    end
    
    %% Завершення базового потоку
    deactivate Booking
    deactivate Site
