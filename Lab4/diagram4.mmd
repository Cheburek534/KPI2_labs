flowchart TD
    Start((Початок))

    subgraph Client [Клієнт]
        C1[Обирає сеанс та місце]
        C2[Бачить звичайну ціну без знижок]
        C3[Вводить платіжні дані та підтверджує платіж]
        C4[Отримує підтвердження на email]
    end

    subgraph Site [Сайт]
        S1[Відправляє запит на перевірку]
        S2[Повідомляє, що місце зайняте]
        S3[Робить запит getOrderSummary]
        S4[Виводить помилку вводу та повертає до оплати]
        S5[Виводить повідомлення про відхилений платіж]
        S6[Виводить вікно про успішну оплату]
    end

    subgraph Booking [Сервіс бронювання]
        B1[Перевіряє статус місця в БД]
        D1{Чи місце вільне?}
        B2[Блокує місце на 15 хв]
        B3[Обробляє запит та надсилає дані]
        D2{Чи введено студентський?}
        B4[Перевіряє дані на дійсність]
        D3{Дані актуальні?}
        B5[Оновлює ціну зі знижкою]
        B6[Проводить транзакцію]
        D4{Транзакція успішна?}
        D5{Пройшло 15 хвилин?}
        B7[Знімає блок на вибір місця]
        B8[Зберігає статус Продано та знімає блок]
        B9>Відправляє чек на пошту]
    end

    Start --> C1
    C1 --> S1
    S1 --> B1
    B1 --> D1

    D1 -- Ні --> S2
    S2 --> C1

    D1 -- Так --> B2
