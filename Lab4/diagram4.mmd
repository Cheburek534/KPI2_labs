    C2 --> D2

    D2 -- Ні --> C3
    D2 -- Так --> B4
    B4 --> D3

    D3 -- Так --> B5
    B5 --> C3
    
    D3 -- Ні --> S4
    S4 --> C3

    C3 --> B6
    B6 --> D4

    D4 -- Ні --> S5
    S5 --> D5
    D5 -- Так --> B7
    B7 --> EndExpired((Кінець))
    D5 -- Ні --> C3

